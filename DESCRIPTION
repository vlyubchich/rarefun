Package: rarefun
Type: Package
Title: Functions for Rare Events Analysis
Version: 0.1.0
Authors@R: c(
    person("Vyacheslav", "Lyubchich", 
           email = "lyubchich@umces.edu",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-7936-4285")),
    person("Geneviève", "Nesslage", 
